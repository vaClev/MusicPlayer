<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.vasilev.musicpro.desktop.controllers.PlaylistItemController"
      styleClass="playlist-item"
      spacing="8"
      alignment="CENTER_LEFT">

    <!-- Индикатор текущего трека -->
    <Label fx:id="currentIndicator" text="" styleClass="current-indicator"
           visible="false" managed="false"/>

    <!-- Информация о треке -->
    <VBox spacing="1" HBox.hgrow="ALWAYS">
        <Label fx:id="titleLabel" styleClass="playlist-item-title"
               text="Название трека" textOverrun="ELLIPSIS"/>
        <Label fx:id="artistLabel" styleClass="playlist-item-artist"
               text="Исполнитель" textOverrun="ELLIPSIS"/>
    </VBox>

    <!-- Длительность -->
    <Label fx:id="durationLabel" styleClass="playlist-item-duration"
           text="00:00" minWidth="35"/>

    <!-- Кнопка удаления -->
    <Button fx:id="removeButton" text="✕" styleClass="playlist-item-remove-btn"
            onAction="#handleRemove" managed="false"/>

</HBox>