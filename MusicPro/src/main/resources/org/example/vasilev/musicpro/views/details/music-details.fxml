<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.vasilev.musicpro.controllers.details.MusicDetailsController">

    <top>
        <ToolBar>
            <Button text="Скачать" onAction="#handleDownloadMusic"/>
            <Button text="Воспроизвести" onAction="#handlePlayLocal"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Закрыть" onAction="#handleCloseTab"/>
        </ToolBar>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="15">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>

                <!-- Главная секция -->
                <HBox spacing="15">
                    <!-- Блок с иконкой или заглушкой -->
                    <Pane prefWidth="150" prefHeight="150" style="-fx-background-color: #2d2d2d;"/>

                    <VBox spacing="8">
                        <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label fx:id="artistLabel" style="-fx-font-size: 16px;"/>
                        <HBox spacing="10">
                            <Label fx:id="durationLabel"/>
                            <ProgressIndicator fx:id="downloadProgress" visible="false"/>
                            <Label fx:id="downloadStatusLabel"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Дополнительная информация -->
                <VBox spacing="10">
                    <HBox spacing="20">
                        <Label text="Альбом:" style="-fx-min-width: 100;"/>
                        <Label fx:id="albumLabel" style="-fx-font-weight: bold;"/>
                    </HBox>

                    <HBox spacing="20">
                        <Label text="Жанр:" style="-fx-min-width: 100;"/>
                        <Label fx:id="genreLabel" style="-fx-font-weight: bold;"/>
                    </HBox>

                    <HBox spacing="20">
                        <Label text="Год:" style="-fx-min-width: 100;"/>
                        <Label fx:id="yearLabel" style="-fx-font-weight: bold;"/>
                    </HBox>

                    <HBox spacing="20">
                        <Label text="Размер:" style="-fx-min-width: 100;"/>
                        <Label fx:id="fileSizeLabel" style="-fx-font-weight: bold;"/>
                    </HBox>

                    <!-- uploadDateLabel -->
                    <HBox spacing="20">
                        <Label text="Загружен:" style="-fx-min-width: 100;"/>
                        <Label fx:id="uploadDateLabel" style="-fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Extra Files секции с TitledPane -->
                <VBox spacing="10">
                    <Label text="Дополнительные файлы:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                    <!-- Ноты -->
                    <TitledPane fx:id="sheetMusicPane" text="Ноты" expanded="false">
                        <content>
                            <VBox fx:id="sheetMusicContainer" spacing="5">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Табулатуры -->
                    <TitledPane fx:id="tabsPane" text="Табулатуры" expanded="false">
                        <content>
                            <VBox fx:id="tabsContainer" spacing="5">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Тексты песен -->
                    <TitledPane fx:id="lyricsPane" text="Тексты песен" expanded="false">
                        <content>
                            <VBox fx:id="lyricsContainer" spacing="5">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Аккорды -->
                    <TitledPane fx:id="chordsPane" text="Аккорды" expanded="false">
                        <content>
                            <VBox fx:id="chordsContainer" spacing="5">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Изображения -->
                    <TitledPane fx:id="imagesPane" text="Изображения" expanded="false">
                        <content>
                            <VBox fx:id="imagesContainer" spacing="5">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </VBox>
                        </content>
                    </TitledPane>

                    <!-- Другие файлы -->
                    <TitledPane fx:id="otherFilesPane" text="Другие файлы" expanded="false">
                        <content>
                            <VBox fx:id="otherFilesContainer" spacing="5">
                                <padding>
                                    <Insets top="10" right="10" bottom="10" left="10"/>
                                </padding>
                            </VBox>
                        </content>
                    </TitledPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>